# backend/.env  (gitignored -- copy to .env and fill in)
#
# 사용: cp .env.example .env && 값 채우기
# Phase 1.3 (alembic)에선 DATABASE_URL만 필요. Phase 2부터 나머지 필요.

# ============================================================
# DB (필수)
# ============================================================
#
# Supabase 권장: Session Pooler URL 사용
#   Studio -> Settings -> Database -> Connection string -> "Session pooler" 탭
#   IPv4 호환 (무료 플랜 가정용 인터넷에서 필수. direct connection은 IPv6 only)
#   alembic 마이그레이션 모든 작업 호환 (Transaction pooler:6543 은 일부 비호환)
#
# 형식: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-X-region.pooler.supabase.com:5432/postgres
#   - 사용자명에 .[PROJECT_REF] 가 붙음
#   - 호스트는 aws-...pooler.supabase.com
#   - 포트 5432
#
# core/config.py 가 asyncpg 드라이버로 자동 변환 (postgresql:// -> postgresql+asyncpg://)
# migrations/env.py 는 psycopg 드라이버로 자동 변환 (sync, multi-statement 지원)

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ============================================================
# 환경 / 로깅 (Phase 2부터)
# ============================================================
ENV=dev
APP_NAME=gihagochi-backend
LOG_LEVEL=INFO

# ============================================================
# Supabase (Phase 2부터)
# ============================================================
# Studio -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# Studio -> Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET

# ============================================================
# FCM (Phase 0.2 + Phase 2)
# ============================================================
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
#
# 두 가지 주입 방식 (둘 중 하나만 채우면 됨, 둘 다면 JSON 우선):
#
# (A) 로컬 개발 — 파일 경로 (간단):
#     FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json
#     `secrets/`는 .gitignore에 의해 자동 제외 (service-account*.json 패턴).
#
# (B) Cloud 배포 (Railway/Vercel) — JSON 통째 주입:
#     다운받은 JSON을 한 줄로 minified (newlines 제거)해서:
#     FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
#     (private_key 내부의 \n은 그대로 유지. JSON 표준 escape)

FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_PATH=./secrets/fcm-service-account.json

# ============================================================
# Sentry (Phase 2)
# ============================================================
SENTRY_DSN=https://...@sentry.io/...

# ============================================================
# Rate Limit
# ============================================================
RATE_LIMIT_DEFAULT=60/minute
