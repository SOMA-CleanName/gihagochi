# mobile/.env  (gitignored -- copy to .env and fill in)
#
# 사용: cp .env.example .env && 값 채우기
#
# 주의: flutter_dotenv는 런타임 로드. 빌드 후 .env 파일이 assets에 포함됨.
# 진짜 시크릿은 dart-define 권장 (빌드타임 주입, 앱 번들에 노출 X):
#   flutter run --dart-define=SUPABASE_URL=https://... --dart-define=SUPABASE_ANON_KEY=...
# env.dart가 dart-define 우선, dotenv 폴백으로 처리.

# ── Supabase ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ── 백엔드 API ──
API_BASE_URL=http://localhost:8000

# ── Sentry ──
SENTRY_DSN=https://...@sentry.io/...

# ── 환경 ──
ENV=dev
