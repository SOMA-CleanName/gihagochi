# EditorConfig: https://editorconfig.org
# 모노레포 전체에서 동일한 line ending / indent 규칙 강제
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (backend)
[*.py]
indent_size = 4
max_line_length = 100

# Dart (mobile)
[*.dart]
indent_size = 2
max_line_length = 100

# JavaScript / TypeScript / JSX / TSX (admin)
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# 설정 파일들
[*.{json,yml,yaml,toml}]
indent_size = 2

# Markdown — 줄 끝 공백 두 칸이 의미있을 수 있음
[*.md]
trim_trailing_whitespace = false

# Makefile은 tab 강제
[Makefile]
indent_style = tab
